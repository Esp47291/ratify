# Публичный адрес сайта без слэша в конце — для sitemap и Open Graph
SITE_URL=https://example.com

# Пароль PostgreSQL для docker-compose. Генерация: openssl rand -hex 24
# Только буквы и цифры (пароль подставляется в строку подключения).
POSTGRES_PASSWORD=

# Строка подключения к PostgreSQL.
# В docker-compose для web подставляется сама из POSTGRES_PASSWORD;
# нужна для запуска без Docker и для drizzle-kit (npm run db:push).
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/app_db

# true — для управляемой БД со SSL (большинство хостингов)
DATABASE_SSL=false

# Секрет для подписи сессий (понадобится после перехода на маркетплейс).
# Генерация: openssl rand -hex 32
SESSION_SECRET=

# Порт на хосте (npm start / Docker)
PORT=3000

# Telegram-бот (необязательно — оставьте пустым, пока не нужен)
# 1. Создайте бота у @BotFather и скопируйте токен
# 2. Узнайте ID чата/группы (например, через @userinfobot или getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HTTP-прокси до Telegram API, если api.telegram.org недоступен (например, http://127.0.0.1:10809)
TELEGRAM_PROXY=

# IP для обхода блокировки DNS api.telegram.org в docker-compose (по умолчанию подставлен известный адрес)
# TELEGRAM_API_IP=149.154.167.220

# Адреса локальной сети для dev-сервера через запятую (телефон / другой ПК)
# DEV_ORIGINS=192.168.0.10
