# Public site URL (no trailing slash) — used for sitemap / Open Graph
SITE_URL=http://72.56.232.108:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Set to true for managed Postgres with SSL (many hostings require this)
DATABASE_SSL=false

# Server port (used by `npm start` / Docker)
PORT=3000

# Telegram bot (optional — leave empty until ready)
# 1. Create a bot via @BotFather and copy the token
# 2. Get chat/group ID (e.g. via @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional HTTP proxy for Telegram API (e.g. local xray/clash: http://127.0.0.1:10809)
# Needed when api.telegram.org is blocked for Node (Windows system proxy is not used automatically)
TELEGRAM_PROXY=
